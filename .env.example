# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Legacy alias still supported by the app clients:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Single-administrator allowlist (comma-separated if needed)
ADMIN_EMAILS=you@example.com

# Supabase (server-only — never expose to the browser)
# Only include if trusted admin operations genuinely require it.
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Direct Postgres connection (migrations / server tooling only)
# URL-encode special characters in the password (e.g. # -> %23)
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

